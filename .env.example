# ---------------------------------------------------------------------------
# Project tool (/projects)
# ---------------------------------------------------------------------------

# Postgres connection string. On Vercel use the POOLED connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PM_SESSION_SECRET=

# Seeds the first admin account on first run.
PM_ADMIN_EMAIL=projects@tms-digital.com
PM_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Contact forms
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com). Required to deliver enquiries.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=TMS Website <website@tmsdigitalhub.com>

# Where enquiries are delivered. Defaults to CONTACT_EMAIL in src/lib/contact.ts.
CONTACT_TO_EMAIL=hello@tmsdigitalhub.com

# Optional: post to a third-party handler (Formspree etc.) instead of /api/contact.
# NEXT_PUBLIC_CONTACT_ENDPOINT=
