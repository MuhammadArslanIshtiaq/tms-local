# Postgres connection string (Neon, Supabase, or any Postgres).
# On Vercel use the pooled connection string.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign project-tool session cookies (min 32 chars).
PM_SESSION_SECRET=

# Seed credentials for the built-in admin account.
PM_ADMIN_EMAIL=projects@tms-digital.com
PM_ADMIN_PASSWORD=
